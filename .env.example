# 더 라인 환경변수 예시 — 값은 .env.local(내 컴퓨터)과 Vercel 환경변수에만 넣으세요. 이 파일에는 값을 쓰지 않습니다.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # 서버 전용(관리자 페이지·결제·알림)

# 사이트
NEXT_PUBLIC_SITE_URL=https://theline.it.kr
NEXT_PUBLIC_AUTH_PROVIDERS=google,kakao

# 웹 푸시(VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# 앱 푸시(Expo) — 선택
EXPO_ACCESS_TOKEN=

# 결제 — KG이니시스 정기결제(빌링). lib/inicis.js
NEXT_PUBLIC_PAYMENT_PROVIDER=inicis-billing
INICIS_MODE=test                    # test | live
INICIS_MID=                         # 정기결제(빌링)용 상점 아이디 — 테스트는 이니시스 테스트 상점 INIBillTst
INICIS_LITE_KEY=                    # INILite Key — 카드 등록·결과 확인(빌링키 복호화)
INICIS_API_KEY=                     # INIAPI Key — 결제 승인·환불
# 연간 1회 결제 — 일반결제 상점(정기결제 상점과 다른 MID). 테스트는 이니시스 테스트 상점 INIpayTest
INICIS_PAY_MID=
INICIS_PAY_HASH_KEY=                # 모바일 금액위변조 Hash Key(PC 결제창에도 이 키)
INICIS_PAY_API_KEY=                 # 그 상점의 INIAPI Key — 환불

# 자동갱신 크론(/api/billing/renew) — Vercel이 이 값으로 부릅니다
CRON_SECRET=
