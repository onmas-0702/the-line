{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "next-dev-preview-admin",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_PUBLIC_PREVIEW_ADMIN=true",
        "npx",
        "next",
        "dev",
        "-p",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "next-dev-3001",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "next-prod-3002",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npx next build && npx next start -p 3002"
      ],
      "port": 3002
    },
    {
      "name": "app-web",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd '/Users/apple/Documents/더 라인 앱' && npx expo start --web --port 8082"
      ],
      "port": 8082
    }
  ]
}